# URL publique du backend Express (server/). En local : http://localhost:4000
# En production, pointez vers l'adresse où tourne votre API Node.js + Express.
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL publique du site (métadonnées Open Graph, robots.txt, sitemap.xml)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (espace « supporter » : inscription / connexion) -------------
# Récupérez ces valeurs dans Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon-publique
