# Port d'écoute de l'API Express
PORT=4000

# Environnement : development | production
NODE_ENV=development

# Origines autorisées pour CORS (séparées par des virgules). Mettez l'URL
# exacte de votre site Cloudflare Pages, ex: https://fifa26-control.pages.dev
CORS_ORIGIN=http://localhost:3000

# --- Base de données : Supabase (PostgreSQL) --------------------------------
# Récupérez cette chaîne dans Supabase → Project Settings → Database →
# Connection string → "URI" (choisissez "Transaction pooler" en production).
# Exemple : postgresql://postgres.xxxxx:VOTRE_MOT_DE_PASSE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Secret utilisé pour signer les jetons JWT — changez-le en production
# (générez-en un avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-moi-en-production-avec-une-valeur-aleatoire-longue
JWT_EXPIRES_IN=12h

# Identifiants du compte admin créé automatiquement par "npm run seed"
SEED_ADMIN_EMAIL=admin@fifa26.control
SEED_ADMIN_PASSWORD=ChangeMoi123!
